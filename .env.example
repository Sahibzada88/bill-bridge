# =====================================================================
# EASIEST WAY: run   npm run setup   (it asks for these values and writes .env.local for you)
# Or copy this file to .env.local and fill in the first three lines.
# =====================================================================

# ---- 1) REQUIRED: Supabase  (Dashboard -> Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://wsvkvafdpjmxosalwgvr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8hSOhrnfwiZx9H6DhIzO-w_qspOD-4I
# SERVER ONLY. Never put NEXT_PUBLIC_ in front of it. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- 2) Where users open the app (local: http://localhost:3000, live: your real https URL) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 3) Uploaded bills/receipts ----
# database = stored as base64 inside Supabase Postgres (no Storage setup, no extra credentials)  <- default
# storage  = Supabase Storage private bucket
STORAGE_BACKEND=database

# ---- 4) OPTIONAL: Gmail with a Google APP PASSWORD (emails for notifications + contact form) ----
# Create the app password: https://myaccount.google.com/apppasswords  (2-Step Verification must be ON)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where contact-form messages are sent (defaults to GMAIL_USER)
CONTACT_TO=

# ---- 5) OPTIONAL: Cloudflare Turnstile CAPTCHA (free; recommended once the site is public) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true  = forms work even without CAPTCHA keys (default, still rate-limited)
# false = production refuses login/register until Turnstile keys are set
ALLOW_MISSING_CAPTCHA=true
# Set "true" only if you also enabled CAPTCHA in Supabase Auth settings (Supabase then verifies the token).
SUPABASE_AUTH_CAPTCHA=false

# ---- Advanced (all optional) ----
RESERVATION_MINUTES=20
# reserved = only a donor holding a reservation can open the original bill; verified = any email-verified donor
DONOR_ORIGINAL_ACCESS=reserved
# Protects /api/cron/expire-reservations (also flushes emails). Any long random string.
CRON_SECRET=
# Salt for hashed IPs. If empty, one is derived automatically from the service key.
IP_HASH_SALT=
